<h1>Home#index</h1>
<p>Find me in app/views/home/index.html.erb</p>

<%# %>
<%= @numbers %>

<!--CACHE-->
<% cache do %>
  <%= @numbers %>
<% end %>
<ul>
  <% @numbers.each.with_index do |num, idx| %>
    <% cache "number-#{idx}" do %>
      <li><%= num %></li>
    <% end %>
  <% end %>
</ul>
<!--SANITAZERS-->
<%# "<h1><a href='#' style='color:red;'>test text</a></h1><script>alert('test alert')</script>" %>
<%= @text %>

<%# strip_tags видаляє ...? =>  test text alert('test alert') %>
<%= strip_tags @text %>

<%# sanitize видаляє html => alert('test alert') %>
<%= sanitize @text %>

<%# strip_links видаляє links => <h1>test text</h1><script>alert('test alert')</script> %>
<%= strip_links @text %>

<%# strip_links видаляє links + js => <<h1>test text</h1> %>
<%= strip_links(@text).html_safe %>

<%# strip_links залишає лише html+css%>
<%= sanitize_css(@text) %>

<%= image_tag 'tests.jpg' %>

